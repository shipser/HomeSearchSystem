# ------------------------------------------------------------------------------
# Apartment Checklist - Server Environment Configuration
# ------------------------------------------------------------------------------

# Host port mapping (default: 3000)
PORT=3000

# Public URL of your deployed application (optional, recommended for custom domains)
# When set, the in-app QR code and logs will point directly to this domain/IP.
# Example: https://apartments.yourdomain.com OR http://your-vps-ip:3000
# PUBLIC_URL=https://apartments.yourdomain.com
